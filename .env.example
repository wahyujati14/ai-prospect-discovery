# Active LLM provider: gemini or openai
LLM_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (optional primary or automatic fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional authorized search / platform APIs (falls back to public DuckDuckGo search when unset)
SERPER_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
YOUTUBE_API_KEY=

# Discovery & performance controls
REQUEST_TIMEOUT_SECONDS=12
LLM_TIMEOUT_SECONDS=40
CACHE_TTL_SECONDS=1800
MAX_CONCURRENT_SEARCHES=4
MAX_WEBSITE_ENRICHMENTS=5
PORT=4000
